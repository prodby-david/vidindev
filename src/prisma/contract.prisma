// use prisma-8

model Stack {
  id Uuid @id @default(uuid())
  name String 
  category Category
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Contact {
  id Uuid @id @default(uuid())
  name String
  email String
  phone String?
  subject InquirySubject
  message String
  createdAt TimestamptzString @default(now())
}

model Project {
  id Uuid @id @default(uuid())
  number String
  title String
  description String
  tags String[]
  link String
  imageSrc String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Experience {
  id Uuid @id @default(uuid())
  role String
  company String
  period String
  details String
  skills String[]
  icon ExperienceIcon @default(Code2)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Certification {
  id Uuid @id @default(uuid())
  title String
  institution String
  period String
  details String
  type CertificationType @default(CERTIFICATION)
  credentialImage String
  credentialId String?
  verificationUrl String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model PolaroidSnapshot {
  id Uuid @id @default(uuid())
  src String
  caption String
  alt String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Gear {
  id Uuid @id @default(uuid())
  category GearCategory
  items String[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum InquirySubject {
  PROJECT_COLLABORATION
  JOB_OPPORTUNITY
  TECHNICAL_CONSULTATION
  GENERAL_INQUIRY
  OTHER
}

enum GearCategory {
  HARDWARE
  CODE_TERMINAL
  DESIGN_PROTOTYPE
  WORKFLOW
}

enum Category {
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  DEVTOOLS
}

enum ExperienceIcon {
  Code2
  Terminal
  GraduationCap
}

enum CertificationType {
  DEGREE
  CERTIFICATION
}